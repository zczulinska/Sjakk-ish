<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="Chess.ChessController"
           alignment="CENTER">

    <HBox alignment="CENTER" spacing="20">

        <VBox alignment="CENTER" spacing="10">
            <Label text="Hvite trekk" />
            <TextArea fx:id="whiteMovesArea"
                      editable="false"
                      prefWidth="160"
                      prefHeight="640" />
        </VBox>

        <VBox alignment="CENTER" spacing="10">
            <Label fx:id="statusLabel"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;" />
            <GridPane fx:id="chessBoard" alignment="CENTER"/>
            <Button text="Nytt parti" onAction="#nyttParti" />
        </VBox>

        <VBox alignment="CENTER" spacing="10">
            <Label text="Svarte trekk" />
            <TextArea fx:id="blackMovesArea"
                      editable="false"
                      prefWidth="160"
                      prefHeight="640" />
        </VBox>

    </HBox>

    <VBox fx:id="gameOverBox"
          alignment="CENTER"
          spacing="10"
          visible="false"
          prefWidth="420"
          prefHeight="180"
          maxWidth="420"
          maxHeight="180"
          style="-fx-background-color: red;
                 -fx-padding: 30;
                 -fx-border-color: black;
                 -fx-border-width: 3;
                 -fx-background-radius: 15;
                 -fx-border-radius: 15;">

        <Label text="GAME OVER"
               style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: white;" />

        <Label fx:id="winnerLabel"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" />
    </VBox>

</StackPane>